# =============================================================================
# Verqelio - shared local/deployment environment
# Copy to .env.local for local work. Never commit real secrets.
# =============================================================================

NEXT_PUBLIC_PRODUCT_NAME=Verqelio
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional browser-visible key for real API reads; local mock mode does not need it.
NEXT_PUBLIC_VERQELIO_API_KEY=
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres

# Stellar / Soroban testnet defaults
STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_WALLET=real
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
DID_REGISTRY_CONTRACT_ID=CAJQFHGAJR5Q2NMGM7IYGM2KK6FLQXT634XZMGEYKKOYN2E2ONCFRSQK
VC_VAULT_FACTORY_CONTRACT_ID=CB23E4GXNRJ367BVPDRMGLADKBQLCWMAWP6SZVGFJPMR2D6I3KBA3B4H
# Optional alias accepted by the API for older deployments.
FACTORY_CONTRACT_ID=
VC_VAULT_WASM_HASH=2bd0323a98acb8469606808368da6c79824f2dd8391494b94ddbeb3d22c1a957

# API security - generate each with: openssl rand -hex 32
API_KEY_SECRET=replace-with-random-hex
ADMIN_BOOTSTRAP_SECRET=replace-with-random-hex
CREDENTIAL_ENCRYPTION_KEY=replace-with-random-hex
ISSUER_IDENTITY_ENCRYPTION_KEY=replace-with-random-hex
CRON_SECRET=replace-with-random-hex
CORS_ORIGIN=http://localhost:3001
# Optional alias accepted by the API for older deployments.
CORS_ALLOWED_ORIGINS=

# Optional: backend-sponsored DID/vault transactions
SPONSOR_SECRET_KEY=

# Optional durable share links
PRESENTATION_STORE_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP / Mailtrap
EMAIL_FROM=Verqelio <no-reply@example.com>
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=replace-with-mailtrap-username
EMAIL_PASSWORD=replace-with-mailtrap-password
EMAIL_APP_PASSWORD=

# Optional ingestion integrations; leave blank for the MVP
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_FORM_ID=
GOOGLE_FORM_SOURCE_ID=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SITE_ID=
