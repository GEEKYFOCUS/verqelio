{
  "name": "@verqelio/did-stellar",
  "version": "0.1.3",
  "description": "Official TypeScript SDK for the did:stellar v0.1 method. DIF did-resolver compatible, prepare/submit XDR helpers, and W3C-compliant DID Document construction.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./resolver": "./src/resolver/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node init && tsup",
    "build:watch": "node init && tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo coverage",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "did",
    "did-stellar",
    "did-resolver",
    "stellar",
    "soroban",
    "self-sovereign-identity",
    "ssi",
    "w3c",
    "verifiable-credentials",
    "decentralized-identity",
    "dif"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/GEEKYFOCUS/verqelio/tree/main/packages/did-stellar",
  "repository": {
    "type": "git",
    "url": "https://github.com/GEEKYFOCUS/verqelio.git",
    "directory": "packages/did-stellar"
  },
  "bugs": {
    "url": "https://github.com/GEEKYFOCUS/verqelio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@scure/base": "^1.1.9",
    "@stellar/stellar-sdk": "^15.0.0",
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.1 <25"
  }
}
