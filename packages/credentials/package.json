{
  "name": "@verqelio/credentials",
  "version": "1.1.10",
  "description": "Verqelio credentials SDK for Stellar",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "scripts": {
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "build": "tsup src/index.ts src/types/index.ts src/hooks/index.ts --format esm,cjs --dts",
    "build:watch": "tsup src/index.ts src/types/index.ts src/hooks/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "npm run build",
    "publish:github": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Verqelio-Team/verqelio-credentials.git"
  },
  "keywords": [
    "react",
    "hooks",
    "verqelio",
    "credentials",
    "api",
    "verification",
    "institutional",
    "digital-identity",
    "verifiable-credentials"
  ],
  "author": "ACTA",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "dependencies": {
    "@verqelio/did-stellar": "workspace:*",
    "@noble/ed25519": "^2.1.0",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ts-jest": "^29.3.4",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "axios": "^1.18.1"
  }
}
