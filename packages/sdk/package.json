{
  "name": "@credport/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Thin integration layer over @credport/credentials. Products consume CredPort exclusively through this package.",
  "exports": {
    ".": "./src/index.ts",
    "./did": "./src/did.ts",
    "./hooks": "./src/hooks.ts",
    "./types": "./src/types.ts",
    "./presentation": "./src/presentation.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
