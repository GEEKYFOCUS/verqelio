    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@credport/config": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
